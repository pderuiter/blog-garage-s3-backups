{% set ns = garage_backup_job.namespace | default(garage_backup_job.name) %}
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: garage-credentials
  namespace: {{ ns }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ garage_backup_eso_store }}
  target:
    name: garage-credentials
  data:
    - secretKey: ACCESS_KEY
      remoteRef:
        key: {{ garage_backup_eso_garage_key }}
        property: access-key-id
    - secretKey: SECRET_KEY
      remoteRef:
        key: {{ garage_backup_eso_garage_key }}
        property: secret-access-key
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ garage_backup_job.name | regex_replace('-backup$', '') }}-db-password
  namespace: {{ ns }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ garage_backup_eso_store }}
  target:
    name: {{ garage_backup_job.name | regex_replace('-backup$', '') }}-db-password
  data:
    - secretKey: password
      remoteRef:
        key: {{ garage_backup_eso_db_key_prefix }}{{ garage_backup_job.name | regex_replace('-backup$', '') }}-db
        property: password
